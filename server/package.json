{
  "name": "coinche-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SERVER_ENV=dev tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/server/src/index.js",
    "test": "run-p test:e2e",
    "test:e2e": "jest --config ./jest.e2e-config.js --verbose",
    "lint": "run-p lint:es lint:tsc",
    "lint:fix": "run-p lint:fix:es",
    "lint:es": "eslint --max-warnings 0",
    "lint:fix:es": "eslint --fix",
    "lint:tsc": "tsc",
    "prepare": "cd .. && husky"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "boardgame.io": "0.50.2",
    "koa-route": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/koa": "2.15.2",
    "@types/koa-route": "3.2.9",
    "@types/node": "24.13.4",
    "@types/supertest": "7.2.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "17.5.1",
    "npm-run-all": "4.1.5",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": "eslint --fix"
  }
}
